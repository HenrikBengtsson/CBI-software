]==]

local function eula_blocked()
   local hr = string.rep("-", 72)
   local msg = table.concat({
      "",
      hr,
      "'" .. name .. "/" .. version .. "' is not installed on this system",
      hr,
      "",
      reason,
      "The end-user license agreement (EULA) is available at:",
      "",
      "  <{{ EULA_URL }}>",
      "",
      hr,
      "",
   }, "\n")

   -- Only report, but do not fail, while the module is being installed
   if (os.getenv("MODULE_INSTALLATION")) then
      io.stderr:write(msg .. "\n")
